/* notora 界面主题 — generated from tokens.json */

:root, [data-theme="light"] {
  --surface-window: #fcfaf8;
  --surface-navigation: #fefdfc;
  --surface-overlay: #ffffff;
  --surface-editor: #ffffff;
  --editor-line-number: #75695c;
  --surface-hover: var(--button-hover);
  --surface-selected: #f8e5d2;
  --surface-row-hover: #f9f7f4;
  --surface-row-selected: #f8e5d2;
  --ink: #202020;
  --ink-muted: #62666c;
  --ink-inverse: #ffffff;
  --ink-row-selected: #9a4815;
  --divider: #efeae3;
  --line-strong: #ded8d1;
  --control-bg: #ffffff;
  --control-border: #9f8d76;
  --button-bg: #fbfbfb;
  --button-border: #d2ccc5;
  --button-hover: #f7f7f7;
  --button-pressed: #f1f1f1;
  --danger-bg: #f9f3f2;
  --danger-hover: #f7eae9;
  --danger-pressed: #f6e1e0;
  --danger-border: #db9f97;
  --danger-label: #983d35;
  --accent: #e97924;
  --on-accent: #2a1808;
  --accent-text: #9a4815;
  --danger: #e45649;
  --danger-text: #b3261e;
  --warning: #c18401;
  --warning-text: #8a5a00;
  --focus-ring: #c2410c;
  --scrim: #00000073;
}

[data-theme="dark"] {
  --surface-window: #332d29;
  --surface-navigation: #27221f;
  --surface-overlay: #36302b;
  --surface-editor: #191614;
  --editor-line-number: #a99b8e;
  --surface-hover: var(--button-hover);
  --surface-selected: #f59a4a24;
  --surface-row-hover: #433a33;
  --surface-row-selected: #493529;
  --ink: #f2ede8;
  --ink-muted: #b8ada3;
  --ink-inverse: #211e1c;
  --ink-row-selected: #f2a659;
  --divider: #463c35;
  --line-strong: #77695d;
  --control-bg: #211d1a;
  --control-border: #77695d;
  --button-bg: #2f2c2a;
  --button-border: #8d8279;
  --button-hover: #3d3b3a;
  --button-pressed: #454341;
  --danger-bg: #53312d;
  --danger-hover: #6a3631;
  --danger-pressed: #7c3a34;
  --danger-border: #bf6f64;
  --danger-label: #edc2bc;
  --accent: #f59a4a;
  --on-accent: #2a1504;
  --accent-text: #f2a659;
  --danger: #e45649;
  --danger-text: #f08a7f;
  --warning: #dfc184;
  --warning-text: #e5ca9a;
  --focus-ring: #f59a4a;
  --scrim: #00000073;
}

:root {
  --space-1: 2px;
  --space-2: 4px;
  --space-3: 8px;
  --space-4: 10px;
  --space-5: 12px;
  --space-6: 16px;
  --space-7: 24px;
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;
  --control-height: 32px;
  --bar-height: 28px;
  --title-bar-height: 36px;
  --row-height: 32px;
  --tree-row-height: 28px;
  --navigation-width: 220px;
  --card-list-width: 340px;
  --icon-size: 16px;
  --font-sans: system-ui, -apple-system, "SF Pro Text", "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-title { font-family: var(--font-sans); font-size: 22px; line-height: 30px; font-weight: 600; letter-spacing: -0.01em; }
.section-title { font-family: var(--font-sans); font-size: 16px; line-height: 22px; font-weight: 600; }
.card-title { font-family: var(--font-sans); font-size: 15px; line-height: 20px; font-weight: 600; }
.body { font-family: var(--font-sans); font-size: 14px; line-height: 20px; font-weight: 400; }
.label { font-family: var(--font-sans); font-size: 13px; line-height: 18px; font-weight: 400; }
.meta { font-family: var(--font-sans); font-size: 12px; line-height: 16px; font-weight: 400; }
.caption { font-family: var(--font-sans); font-size: 11px; line-height: 16px; font-weight: 400; }
