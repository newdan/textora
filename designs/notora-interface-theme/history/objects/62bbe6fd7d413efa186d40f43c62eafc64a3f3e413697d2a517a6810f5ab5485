<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>Button — 预览</title>
<style>
  html, body { margin:0; height:100%; }
  body { background:var(--surface-window); color:var(--ink); font-family:var(--font-sans); -webkit-font-smoothing:antialiased; }
  .stage { box-sizing:border-box; height:100%; padding:20px 24px; display:flex; flex-direction:column; gap:12px; justify-content:center; }
  .row { display:flex; align-items:flex-end; gap:16px; }
  .item { display:flex; flex-direction:column; gap:4px; }
  .cap { font-size:11px; line-height:16px; color:var(--ink-muted); }
  .btn { box-sizing:border-box; height:32px; padding:0 8px; border-radius:8px; border:1px solid var(--button-border);
         background:var(--button-bg); color:var(--ink); font:400 14px/20px var(--font-sans);
         display:inline-flex; align-items:center; gap:4px; cursor:default; }
  .btn.hover { background:var(--button-hover); }
  .btn.pressed { background:var(--button-pressed); }
  .btn.disabled { opacity:.45; }
  .btn.danger { background:var(--danger-bg); border-color:var(--danger-border); color:var(--danger-label); }
  .btn.danger.hover { background:var(--danger-hover); }
  .btn.danger.pressed { background:var(--danger-pressed); }
  .btn.ghost { background:transparent; border-color:transparent; color:var(--ink-muted); }
  .btn.ghost.hover { background:var(--button-hover); color:var(--ink); }
  .btn.icon { width:32px; justify-content:center; padding:0; }
  svg { width:16px; height:16px; flex:none; }
</style>
</head>
<body>
<div class="stage">
  <div class="row">
    <div class="item"><span class="cap">默认</span><button type="button" class="btn">保存</button></div>
    <div class="item"><span class="cap">悬停</span><button type="button" class="btn hover">取消</button></div>
    <div class="item"><span class="cap">按下</span><button type="button" class="btn pressed">更多</button></div>
    <div class="item"><span class="cap">禁用</span><button type="button" class="btn disabled" aria-disabled="true">已禁用</button></div>
  </div>
  <div class="row">
    <div class="item"><span class="cap">危险</span><button type="button" class="btn danger">删除</button></div>
    <div class="item"><span class="cap">危险悬停</span><button type="button" class="btn danger hover">删除</button></div>
    <div class="item"><span class="cap">幽灵 + 图标</span><button type="button" class="btn ghost hover">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      星标</button></div>
    <div class="item"><span class="cap">图标</span><button type="button" class="btn ghost icon" aria-label="更多">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg>
    </button></div>
  </div>
</div>
</body>
</html>
